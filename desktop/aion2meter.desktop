[Desktop Entry]
Type=Application
Name=Daevalog
GenericName=AION 2 Companion
Comment=Start or stop the Daevalog overlay for AION 2
Exec=aion2-meter toggle
Icon=aion2-meter
Terminal=false
Categories=Game;
Keywords=daevalog;aion;dps;meter;overlay;combat;
Actions=start;stop;edit;history;

[Desktop Action start]
Name=Start
Exec=aion2-meter start

[Desktop Action stop]
Name=Stop
Exec=aion2-meter stop

[Desktop Action edit]
Name=Customize
Exec=aion2-meter edit

[Desktop Action history]
Name=Fight history
Exec=aion2-meter history
