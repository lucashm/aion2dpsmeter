{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daevalog",
  "version": "0.1.0",
  "identifier": "io.github.lucashm.daevalog",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [{
      "label": "main",
      "create": false,
      "title": "Daevalog",
      "width": 1320,
      "height": 860,
      "minWidth": 860,
      "minHeight": 600,
      "backgroundColor": "#0b141a",
      "decorations": false,
      "devtools": false
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; script-src 'self'",
      "capabilities": []
    }
  },
  "bundle": { "active": false, "icon": ["../desktop/aion2-meter-elyos.png"] }
}
